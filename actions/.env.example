# ─── Server Configuration ───────────────────────────────────────────────────
PORT=8888
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── Database Configuration (PostgreSQL / Supabase) ─────────────────────────
# For Local Postgres (Docker):
DATABASE_URL="postgresql://hungnguyen:hung2004@localhost:5433/HanoiGO_db"

# For Supabase Cloud Deployment:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── Supabase Storage (Media / Uploads) ──────────────────────────────────────
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_OR_ANON_KEY]
# SUPABASE_BUCKET=hanoigo-uploads

# ─── Redis (Socket.io Adapter & Presence Cache) ──────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Authentication & Security ──────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production

# ─── Mail Service (SMTP / OTP Verification) ──────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_FROM="HanoiGO <noreply@hanoigo.com>"

# ─── Third-Party APIs ────────────────────────────────────────────────────────
# Goong Maps API (Directions & Distance Matrix)
GOONG_API_KEY=your_goong_api_key_here

# Google Gemini AI (AI Assistant / Chat / Trip Recommendations)
GEMINI_API_KEY=your_gemini_api_key_here
