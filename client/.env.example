# ─── Backend API URL ────────────────────────────────────────────────────────
# Local development:
NEXT_PUBLIC_ACTIONS_URL=http://localhost:8888

# Production (Render/Custom Domain):
# NEXT_PUBLIC_ACTIONS_URL=https://hanoigo-api.onrender.com

# ─── Maps & Navigation APIs ──────────────────────────────────────────────────
